rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "thnkks9@gmail.com" ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isOwner(userId) &&
        request.resource.data.keys().hasAll(['uid', 'email']) &&
        request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(userId) &&
        request.resource.data.uid == resource.data.uid &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) || isAdmin());
      allow delete: if isAdmin();
    }

    // Farmers Collection
    match /farmers/{farmerId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() &&
        request.resource.data.keys().hasAll(['id', 'name', 'phone', 'village', 'district', 'policyNumber']) &&
        request.resource.data.name is string && request.resource.data.name.size() <= 150;
      allow delete: if isAdmin();
    }

    // Agricultural Fields Collection
    match /fields/{fieldId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() &&
        request.resource.data.keys().hasAll(['id', 'farmerId', 'name', 'cropType', 'areaAcres', 'latitude', 'longitude']) &&
        request.resource.data.name is string && request.resource.data.name.size() <= 200;
      allow delete: if isAdmin();
    }

    // Drone Images Collection
    match /images/{imageId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() &&
        request.resource.data.keys().hasAll(['id', 'fieldId', 'captureDate', 'imageUrl']);
      allow delete: if isAdmin();
    }

    // AI Analysis Results
    match /analyses/{analysisId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() &&
        request.resource.data.keys().hasAll(['id', 'imageId', 'fieldId', 'farmerId', 'analysisDate', 'damagePercentage']);
      allow delete: if isAdmin();
    }

    // Insurance Claims Collection
    match /claims/{claimId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasAll(['id', 'farmerId', 'fieldId', 'policyNumber', 'damagePercentage', 'affectedArea', 'status']);
      allow update: if isSignedIn() && (
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'adminRemarks', 'verifiedBy', 'verifiedAt'])
      );
      allow delete: if isAdmin();
    }

    // Claim Verifications Collection
    match /verifications/{verificationId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasAll(['id', 'claimId', 'decision', 'remarks', 'verificationDate']);
      allow update, delete: if isAdmin();
    }

    // Environmental Events Collection
    match /environmental_events/{eventId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() &&
        request.resource.data.keys().hasAll(['id', 'fieldId', 'eventType', 'severity', 'damagePercentage']);
      allow delete: if isAdmin();
    }
  }
}
